{
  "manifest_version": 3,
  "name": "WebMCP Capability Forge",
  "version": "0.1.0",
  "description": "Teach, discover, and reuse workflows as WebMCP tools.",
  "homepage_url": "https://webmcp-forge.jules-tnk.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage", "tabs", "sidePanel", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capability Forge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
